{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "brand": {
      "type": [
        "string",
        "null"
      ]
    },
    "packaging": {
      "type": [
        "string",
        "null"
      ]
    },
    "main_feature": {
      "type": [
        "string",
        "null"
      ]
    },
    "share_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "thumbnail": {
      "type": [
        "string",
        "null"
      ]
    },
    "price": {
      "type": "object",
      "properties": {
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bulk": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_percentage": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_size": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pack_size": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_units": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "drained_weight": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "increment_amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_discounted": {
          "type": "boolean"
        },
        "is_new": {
          "type": "boolean"
        },
        "is_pack": {
          "type": "boolean"
        },
        "approximate_size": {
          "type": "boolean"
        }
      },
      "required": [
        "unit",
        "previous",
        "bulk",
        "reference",
        "tax_percentage",
        "unit_size",
        "pack_size",
        "total_units",
        "drained_weight",
        "minimum_amount",
        "increment_amount",
        "unit_name",
        "size_format",
        "reference_format",
        "is_discounted",
        "is_new",
        "is_pack",
        "approximate_size"
      ],
      "additionalProperties": false
