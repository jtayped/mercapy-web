    "published": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "availability_limit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "unavailable_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "unavailable_weekdays": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "layout": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "published": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "is_extended": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "level",
          "parent_id",
          "order",
          "layout",
          "published",
          "is_extended",
          "image_url",
          "subtitle"
        ],
        "additionalProperties": false
      }
    },
    "requires_age_check": {
      "type": "boolean"
    },
    "is_water": {
      "type": "boolean"
    },
    "is_new_arrival": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "slug",
    "brand",
    "packaging",
    "main_feature",
    "share_url",
    "thumbnail",
    "price",
    "published",
    "status",
    "availability_limit",
    "unavailable_from",
    "unavailable_weekdays",
    "categories",
    "requires_age_check",
    "is_water",
    "is_new_arrival"
  ],
  "additionalProperties": false
}
