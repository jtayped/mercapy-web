# local development. compose.dev.yaml publishes postgres 18 on 5435 so it does
# not collide with other projects' databases on 5432-5434.
POSTGRES_PASSWORD=mercapy-dev
DATABASE_URL=postgresql://mercapy:mercapy-dev@localhost:5435/mercapy
TEST_DATABASE_URL=postgresql://mercapy:mercapy-dev@localhost:5435/mercapy_test

# collector
MERCAPY_LANGUAGE=ca
MERCAPY_REQUEST_INTERVAL=0.5
MERCAPY_STALE_HOURS=72
MERCAPY_DISCONTINUED_DAYS=14
MERCAPY_DETAIL_DAILY_BUDGET=3000
# POLICY.md: an identifiable user agent with a contact address, always.
MERCAPY_USER_AGENT=mercapy-web/0.1 (+https://mercapy.joeltaylor.business; contact@joeltaylor.business)
